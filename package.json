{
  "name": "lists",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build:css": "bunx @tailwindcss/cli -i src/styles/app.css -o public/styles.css --minify",
    "build:js": "bun build src/client.ts --target browser --outfile public/app.js --minify",
    "build:assets": "bun run build:css && bun run build:js",
    "dev": "bun run build:assets && bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:local": "LOCAL_E2E=1 bun test tests/local-stack.e2e.test.ts --timeout 45000",
    "local:up": "docker compose up --build --wait",
    "local:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build:assets"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "@types/bun": "latest",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.14",
    "@types/sharp": "^0.32.0",
    "@types/sns-validator": "^0.3.3",
    "aws-sdk-client-mock": "^4.1.0",
    "drizzle-kit": "^0.31.9",
    "tailwindcss": "^4.2.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/client-sesv2": "^3.1009.0",
    "@aws-sdk/client-sqs": "^3.1009.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "@elysia/html": "^1.4.1",
    "@elysia/static": "^1.4.11",
    "@react-email/components": "^1.0.9",
    "@react-email/render": "^2.0.4",
    "@types/aws-lambda": "^8.10.161",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.30",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "htmx.org": "^2.0.10",
    "mailparser": "^3.9.4",
    "marked": "^17.0.4",
    "nodemailer": "^8.0.3",
    "sharp": "^0.34.5",
    "sns-validator": "^0.3.5",
    "zod": "^4.3.6"
  }
}
