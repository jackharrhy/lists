{
  "name": "lists",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build:css": "bunx @tailwindcss/cli -i src/styles/app.css -o public/styles.css --minify",
    "build:js": "bun build src/client.ts --target browser --outfile public/app.js --minify",
    "build:assets": "bun run build:css && bun run build:js",
    "dev": "bun run build:assets && bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:local": "LOCAL_E2E=1 bun test tests/local-stack.e2e.test.ts --timeout 45000",
    "local:up": "docker compose up --build --wait",
    "local:down": "docker compose down",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint src tests emails",
    "lint:fix": "oxlint src tests emails --fix",
    "typecheck": "tsc --noEmit",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test && bun run build:assets"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/client-sesv2": "^3.1120.0",
    "@aws-sdk/client-sqs": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@elysia/html": "^1.4.1",
    "@elysia/static": "^1.4.11",
    "@elysiajs/openapi": "^1.4.15",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@types/aws-lambda": "^8.10.162",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "handlebars": "^4.7.9",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "htmx.org": "^2.0.10",
    "mailparser": "^3.9.17",
    "marked": "^18.0.11",
    "mjml": "^5.4.0",
    "nodemailer": "^9.0.6",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "sns-validator": "^0.3.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/mjml": "^5.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/sharp": "^0.32.0",
    "@types/sns-validator": "^0.3.3",
    "aws-sdk-client-mock": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
